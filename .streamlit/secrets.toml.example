# Copy to .streamlit/secrets.toml for local use (that file is git-ignored).
# On Streamlit Community Cloud, paste the same keys into the app's Secrets panel.
# Any key left out falls back to a clearly marked placeholder.

PORTFOLIO_NAME = "Jane Doe"
PORTFOLIO_ROLE = "Data Analyst"
GITHUB_URL     = "https://github.com/your-username"
LINKEDIN_URL   = "https://www.linkedin.com/in/your-profile"
CONTACT_EMAIL  = "you@example.com"
ABOUT_SUMMARY  = "Two or three sentences about your professional background."
EDUCATION      = "Degree, institution, graduation year."
RESUME_PATH    = "assets/resume.pdf"
